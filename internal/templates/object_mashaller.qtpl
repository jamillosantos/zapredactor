{% import "github.com/jamillosantos/zapredactor/internal/domain" %}

{% func Redactor(info domain.Package) -%}
// Code generated by zapredactor. DO NOT EDIT.
package {%s info.Name %}

import (
	"github.com/jamillosantos/zapredactor"
	{%- if info.IncludeZap -%}
	"go.uber.org/zap"
	{%- endif -%}
	"go.uber.org/zap/zapcore"
)

{% for _, s := range info.Structs -%}
{%= RenderStruct(s) %}
{%- endfor %}
{% endfunc %}

{% func RenderStruct(s domain.RedactedStruct) -%}
// redacted{%s s.Name %} logs a {%s s.Name %} redacted. Its method has a pointer receiver, so logging through a pointer does
// not copy the struct.
type redacted{%s s.Name %} {%s s.Name %}

func (s *redacted{%s s.Name %}) MarshalLogObject(encoder zapcore.ObjectEncoder) error {
{%- for _, field := range s.Fields -%}
	{%= RenderField(field) -%}
{%- endfor -%}
	return nil
}

// RedactObject returns the zapcore.ObjectMarshaler that logs the struct redacted without copying it. It is what
// zapredactor.Redact uses when it receives a pointer.
func (s *{%s s.Name %}) RedactObject() zapcore.ObjectMarshaler {
	return (*redacted{%s s.Name %})(s)
}

func (s {%s s.Name %}) Redact(encoder zapcore.ObjectEncoder) error {
	return (*redacted{%s s.Name %})(&s).MarshalLogObject(encoder)
}

// MarshalLogObject implements zapcore.ObjectMarshaler, so zap.Object and zap.Any redact the value too.
func (s {%s s.Name %}) MarshalLogObject(encoder zapcore.ObjectEncoder) error {
	return s.Redact(encoder)
}

{% endfunc %}

{% func RenderValueType(field domain.RedactedField, t string) -%}
{%- if field.IsPointer -%}
	if s.{%s field.Name %} == nil {
		encoder.AddReflected("{%j= field.ExportedName %}", nil)
	} else {
{%- endif -%}
encoder.Add{%s t %}("{%j= field.ExportedName %}", {%- if field.IsPointer -%}*{%- endif -%}s.{%s field.Name %})
{%- if field.IsPointer -%}
	}
{%- endif -%}
{%- endfunc %}

{% func RenderArray(field domain.RedactedField, t string) -%}
zap.{%s t %}("{%j= field.ExportedName %}", s.{%s field.Name %}).AddTo(encoder)
{%- endfunc %}

{% func RenderValueRedacted(field domain.RedactedField, redactor string) -%}
zapredactor.AddRedacted(encoder, "{%j= field.ExportedName %}", s.{%s field.Name %}, "{%j= redactor %}")
{%- endfunc %}

{% func RenderObjectRedacted(field domain.RedactedField) -%}
	{% if field.IsPointer -%}
	if s.{%s field.Name %} == nil {
		encoder.AddReflected("{%j= field.ExportedName %}", nil)
	} else {
	{%- endif -%}
	encoder.AddObject("{%j= field.ExportedName %}", zapredactor.RedactObject({% if !field.IsPointer %}&{% endif %}s.{%s field.Name %}))
	{%- if field.IsPointer -%}
	}
	{%- endif -%}
{%- endfunc %}
